{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentveil.dev/schemas/benchmark.schema.json",
  "title": "AgentVeil value-free benchmark report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "status",
    "git_head_sha",
    "worktree_clean",
    "release_eligible",
    "generated_at_utc",
    "network_scope",
    "build_profile",
    "metric_scope",
    "iterations_per_scenario",
    "warmup_iterations_per_scenario",
    "toolchain",
    "scenarios"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "../../docs/reports/benchmark.schema.json"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "status": {
      "type": "string",
      "enum": ["pass", "template"]
    },
    "git_head_sha": {
      "type": "string",
      "oneOf": [
        {
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "worktree_clean": {
      "type": "boolean"
    },
    "release_eligible": {
      "type": "boolean"
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "network_scope": {
      "type": "string",
      "const": "cargo_offline_loopback_only"
    },
    "build_profile": {
      "type": "string",
      "const": "release"
    },
    "metric_scope": {
      "type": "string",
      "const": "whole_test_process_not_request_latency"
    },
    "iterations_per_scenario": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "warmup_iterations_per_scenario": {
      "type": "integer",
      "minimum": 0,
      "maximum": 50
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cargo_semver", "rustc_semver"],
      "properties": {
        "cargo_semver": {
          "$ref": "#/$defs/semver"
        },
        "rustc_semver": {
          "$ref": "#/$defs/semver"
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "release_eligible": {
            "const": true
          }
        },
        "required": ["release_eligible"]
      },
      "then": {
        "properties": {
          "status": {
            "const": "pass"
          },
          "worktree_clean": {
            "const": true
          },
          "iterations_per_scenario": {
            "const": 25
          },
          "warmup_iterations_per_scenario": {
            "const": 3
          },
          "scenarios": {
            "minItems": 2,
            "maxItems": 2,
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "scenario_id": {
                      "const": "library_protect_restore"
                    }
                  },
                  "required": ["scenario_id"]
                }
              },
              {
                "contains": {
                  "properties": {
                    "scenario_id": {
                      "const": "gateway_wire_proof"
                    }
                  },
                  "required": ["scenario_id"]
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "template"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "release_eligible": {
            "const": false
          },
          "worktree_clean": {
            "const": false
          }
        }
      }
    }
  ],
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "positive_number": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "timing_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum",
        "mean",
        "p50",
        "p95",
        "p99",
        "maximum",
        "total"
      ],
      "properties": {
        "minimum": {
          "$ref": "#/$defs/positive_number"
        },
        "mean": {
          "$ref": "#/$defs/positive_number"
        },
        "p50": {
          "$ref": "#/$defs/positive_number"
        },
        "p95": {
          "$ref": "#/$defs/positive_number"
        },
        "p99": {
          "$ref": "#/$defs/positive_number"
        },
        "maximum": {
          "$ref": "#/$defs/positive_number"
        },
        "total": {
          "$ref": "#/$defs/positive_number"
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "measurement_target",
        "sample_count",
        "iteration_wall_clock_ms",
        "throughput_iterations_per_second"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "enum": ["library_protect_restore", "gateway_wire_proof"]
        },
        "measurement_target": {
          "type": "string",
          "const": "release_test_process_wall_clock"
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "iteration_wall_clock_ms": {
          "$ref": "#/$defs/timing_summary"
        },
        "throughput_iterations_per_second": {
          "$ref": "#/$defs/positive_number"
        }
      }
    }
  }
}
