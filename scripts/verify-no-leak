#!/usr/bin/env python3
"""Fail-closed, value-free leak scan for AgentVeil release evidence."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import stat
import subprocess
import sys
import tempfile
from collections import Counter
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path
from typing import Iterable


SCRIPT_PATH = Path(__file__).resolve()
REPO_ROOT = SCRIPT_PATH.parent.parent
SCANNER_ID = "agentveil-verify-no-leak-v2"
DEFAULT_MAX_BYTES = 16 * 1024 * 1024
DEFAULT_EVIDENCE = ("runtime", "reports/generated")
ALLOWLIST_PATH = REPO_ROOT / "tests/fixtures/leak-manifest.json"
REPORT_ROOT = REPO_ROOT / "reports/generated"
SAFE_PATH_LABEL = re.compile(r"[A-Za-z0-9._+/@-]{1,240}")


@dataclass(frozen=True)
class Rule:
    identifier: str
    pattern: re.Pattern[bytes]


@dataclass(frozen=True)
class Finding:
    source: str
    path: str
    line: int
    rule_id: str


@dataclass(frozen=True)
class ScanError:
    source: str
    path: str
    error_id: str


@dataclass(frozen=True)
class RepositoryMetadata:
    head_commit: str
    clean_worktree: bool


class SafeArgumentParser(argparse.ArgumentParser):
    """Reject invalid input without reflecting attacker-controlled values."""

    def error(self, message: str) -> None:  # noqa: ARG002
        print("verify-no-leak: error=invalid_arguments", file=sys.stderr)
        raise SystemExit(2)


@dataclass(frozen=True)
class HistoryBlob:
    object_id: str
    size: int
    paths: frozenset[str]


SECRET_RULES = (
    Rule("secret.openai", re.compile(rb"\bsk-(?:proj-|svcacct-)?[A-Za-z0-9_-]{20,}\b")),
    Rule("secret.anthropic", re.compile(rb"\bsk-ant-[A-Za-z0-9_-]{20,}\b")),
    Rule("secret.github", re.compile(rb"\b(?:gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{40,})\b")),
    Rule("secret.aws_access_key", re.compile(rb"\b(?:AKIA|ASIA)[A-Z0-9]{16}\b")),
    Rule("secret.google_api", re.compile(rb"\bAIza[0-9A-Za-z_-]{35}\b")),
    Rule("secret.slack", re.compile(rb"\bxox[baprs]-[0-9A-Za-z-]{20,}\b")),
    Rule("secret.stripe_live", re.compile(rb"\b(?:sk|rk)_live_[0-9A-Za-z]{16,}\b")),
    Rule("secret.gitlab", re.compile(rb"\bglpat-[0-9A-Za-z_-]{20,}\b")),
    Rule("secret.huggingface", re.compile(rb"\bhf_[0-9A-Za-z]{30,}\b")),
    Rule("secret.npm", re.compile(rb"\bnpm_[0-9A-Za-z]{36}\b")),
    Rule("secret.pypi", re.compile(rb"\bpypi-[0-9A-Za-z_-]{50,}\b")),
    Rule(
        "secret.sendgrid",
        re.compile(rb"\bSG\.[0-9A-Za-z_-]{16,}\.[0-9A-Za-z_-]{20,}\b"),
    ),
    Rule("secret.age", re.compile(rb"\bAGE-SECRET-KEY-1[0-9A-Z]{40,}\b", re.IGNORECASE)),
    Rule(
        "secret.jwt",
        re.compile(rb"\beyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\b"),
    ),
    Rule(
        "secret.credentialed_database_url",
        re.compile(
            rb"\b(?:postgres(?:ql)?|mysql|mongodb(?:\+srv)?|redis)://[^\s/:@]{1,128}:[^\s/@]{1,256}@",
            re.IGNORECASE,
        ),
    ),
    Rule(
        "secret.bearer_literal",
        re.compile(rb"\bBearer[ \t]+[A-Za-z0-9._~+/=-]{20,}\b", re.IGNORECASE),
    ),
    Rule(
        "secret.generic_assignment",
        re.compile(
            rb"\b(?:api[_-]?key|client[_-]?secret|access[_-]?token|auth[_-]?token|password|passwd)\b"
            rb"[ \t]*[:=][ \t]*[\"']?[A-Za-z0-9+/=_-]{16,}",
            re.IGNORECASE,
        ),
    ),
    Rule(
        "secret.private_key_block",
        re.compile(
            rb"-----BEGIN (?:ENCRYPTED |RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----"
            rb"[\s\S]{64,16384}?"
            rb"-----END (?:ENCRYPTED |RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----"
        ),
    ),
    Rule(
        "secret.private_key_header",
        re.compile(rb"-----BEGIN (?:ENCRYPTED |RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----"),
    ),
)


EVIDENCE_ONLY_RULES = (
    Rule(
        "protected.email",
        re.compile(
            rb"(?<![A-Za-z0-9.!#$%&'*+/=?^_`{|}~-])"
            rb"[A-Za-z0-9.!#$%&'*+/=?^_`{|}~-]{1,64}"
            rb"@[A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?\.[A-Za-z]{2,63}"
        ),
    ),
    Rule(
        "protected.phone",
        re.compile(rb"(?<!\d)(?:\+?1[-. ]?)?\(?[2-9]\d{2}\)?[-. ]\d{3}[-. ]\d{4}(?!\d)"),
    ),
    Rule(
        "protected.private_ip",
        re.compile(
            rb"(?<!\d)(?:10(?:\.\d{1,3}){3}|192\.168(?:\.\d{1,3}){2}|172\.(?:1[6-9]|2\d|3[01])(?:\.\d{1,3}){2})(?!\d)"
        ),
    ),
    Rule(
        "protected.home_path",
        re.compile(rb"(?:/Users/|/home/)[A-Za-z0-9._-]{1,128}/"),
    ),
    Rule(
        "protected.internal_hostname",
        re.compile(rb"\b[A-Za-z0-9](?:[A-Za-z0-9-]{0,62}\.)+(?:internal|local|agentveil\.test)\b", re.IGNORECASE),
    ),
    Rule("protected.demo_custom_term", re.compile(rb"\bPROJECT-VEIL-DEMO\b")),
    Rule("protected.agentveil_token", re.compile(rb"\[AV_[A-Z0-9_]{8,}\]")),
)


FORBIDDEN_TRACKED_NAMES = frozenset(
    {
        ".env",
        "auth.json",
        "credentials.json",
        "id_dsa",
        "id_ecdsa",
        "id_ed25519",
        "id_rsa",
    }
)
FORBIDDEN_TRACKED_SUFFIXES = (
    ".key",
    ".p12",
    ".pfx",
    ".pem",
    ".ledger",
    ".capture",
    ".audit.jsonl",
)
FORBIDDEN_TRACKED_PREFIXES = ("runtime/", "reports/generated/", "dist/", "target/")


def parse_args() -> argparse.Namespace:
    parser = SafeArgumentParser(
        description=(
            "Scan tracked files and repository-local runtime evidence without ever "
            "printing matched values."
        )
    )
    parser.add_argument(
        "--evidence",
        action="append",
        default=[],
        metavar="PATH",
        help="repository-local evidence file or directory; may be repeated",
    )
    parser.add_argument(
        "--no-default-evidence",
        action="store_true",
        help="do not scan runtime/ and reports/generated/ when they exist",
    )
    parser.add_argument(
        "--no-tracked",
        action="store_true",
        help="skip Git tracked files (not valid for a release gate)",
    )
    parser.add_argument(
        "--no-history",
        action="store_true",
        help="skip unique reachable Git blobs (not valid for a release gate)",
    )
    parser.add_argument(
        "--max-bytes",
        type=positive_integer,
        default=DEFAULT_MAX_BYTES,
        help=f"maximum bytes per file before failing closed (default: {DEFAULT_MAX_BYTES})",
    )
    parser.add_argument(
        "--report",
        metavar="PATH",
        help="write a value-free JSON report inside this repository",
    )
    parser.add_argument(
        "--rehearsal",
        action="store_true",
        help="mark a generated report release-ineligible despite a passing scan",
    )
    return parser.parse_args()


def positive_integer(raw: str) -> int:
    try:
        value = int(raw)
    except ValueError as error:
        raise argparse.ArgumentTypeError("must be an integer") from error
    if value <= 0:
        raise argparse.ArgumentTypeError("must be greater than zero")
    return value


def repository_relative(path: Path) -> str | None:
    try:
        relative = path.relative_to(REPO_ROOT)
    except ValueError:
        return None
    return relative.as_posix()


def label_is_safe(label: str) -> bool:
    if SAFE_PATH_LABEL.fullmatch(label) is None:
        return False
    encoded = os.fsencode(label)
    return not any(
        rule.pattern.search(encoded)
        for rule in (*SECRET_RULES, *EVIDENCE_ONLY_RULES)
    )


def safe_label(path: Path) -> str:
    relative = repository_relative(path)
    if relative is None:
        return "outside-repository"
    return relative if label_is_safe(relative) else "redacted-path"


def is_within_repo(path: Path) -> bool:
    try:
        path.relative_to(REPO_ROOT)
    except ValueError:
        return False
    return True


def path_has_symlink(path: Path) -> bool:
    try:
        relative = path.relative_to(REPO_ROOT)
    except ValueError:
        return True
    cursor = REPO_ROOT
    for component in relative.parts:
        cursor = cursor / component
        if cursor.is_symlink():
            return True
    return False


def load_allowlist() -> dict[tuple[str, str, str, str], frozenset[str]]:
    if not ALLOWLIST_PATH.exists():
        return {}
    if ALLOWLIST_PATH.is_symlink():
        raise ValueError("allowlist is a symlink")
    document = json.loads(ALLOWLIST_PATH.read_text(encoding="utf-8"))
    if document.get("version") != 3 or set(document) != {"version", "allow_matches"}:
        raise ValueError("allowlist schema is invalid")

    entries = document["allow_matches"]
    if not isinstance(entries, list):
        raise ValueError("allowlist entries are invalid")
    allowed: dict[tuple[str, str, str, str], set[str]] = {}
    for entry in entries:
        if not isinstance(entry, dict) or set(entry) != {
            "sources",
            "rule_id",
            "sha256",
            "content_sha256",
            "paths",
        }:
            raise ValueError("allowlist entry schema is invalid")
        sources = entry["sources"]
        rule_id = entry["rule_id"]
        digest = entry["sha256"]
        content_digest = entry["content_sha256"]
        paths = entry["paths"]
        if (
            not isinstance(sources, list)
            or not sources
            or len(sources) != len(set(sources))
            or any(source not in {"tracked", "history"} for source in sources)
        ):
            raise ValueError("allowlist sources are invalid")
        if not isinstance(rule_id, str) or not re.fullmatch(r"[a-z0-9_.]+", rule_id):
            raise ValueError("allowlist rule identifier is invalid")
        if not isinstance(digest, str) or not re.fullmatch(r"[0-9a-f]{64}", digest):
            raise ValueError("allowlist digest is invalid")
        if not isinstance(content_digest, str) or not re.fullmatch(
            r"[0-9a-f]{64}", content_digest
        ):
            raise ValueError("allowlist content digest is invalid")
        if not isinstance(paths, list) or not paths:
            raise ValueError("allowlist paths are invalid")
        for path in paths:
            if (
                not isinstance(path, str)
                or not path
                or path.startswith(("/", "../"))
                or "/../" in path
                or "\\" in path
                or "\0" in path
                or "\n" in path
                or "\r" in path
            ):
                raise ValueError("allowlist path is invalid")
            for source in sources:
                allowed.setdefault(
                    (source, rule_id, digest, content_digest), set()
                ).add(path)
    return {key: frozenset(paths) for key, paths in allowed.items()}


def git_output(arguments: list[str], input_data: bytes | None = None) -> bytes:
    result = subprocess.run(
        ["git", "-C", str(REPO_ROOT), *arguments],
        check=True,
        input=input_data,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    return result.stdout


def repository_metadata() -> RepositoryMetadata:
    head = git_output(["rev-parse", "--verify", "HEAD"]).strip().decode("ascii")
    if re.fullmatch(r"[0-9a-f]{40,64}", head) is None:
        raise ValueError("repository HEAD is invalid")
    clean = not git_output(["status", "--porcelain=v1", "--untracked-files=all"])
    return RepositoryMetadata(head_commit=head, clean_worktree=clean)


def tracked_paths() -> list[Path]:
    output = git_output(["ls-files", "-z", "--cached"])
    return sorted((REPO_ROOT / os.fsdecode(raw) for raw in output.split(b"\0") if raw))


def tracked_ignored_paths() -> frozenset[str]:
    output = git_output(["ls-files", "-z", "--cached", "--ignored", "--exclude-standard"])
    return frozenset(os.fsdecode(raw) for raw in output.split(b"\0") if raw)


def history_blobs() -> list[HistoryBlob]:
    listing = git_output(["-c", "core.quotePath=false", "rev-list", "--objects", "--all"])
    object_paths: dict[str, set[str]] = {}
    for line in listing.splitlines():
        raw_object, separator, raw_path = line.partition(b" ")
        object_id = raw_object.decode("ascii")
        if re.fullmatch(r"[0-9a-f]{40,64}", object_id) is None:
            raise ValueError("history object identifier is invalid")
        object_paths.setdefault(object_id, set())
        if separator and raw_path:
            object_paths[object_id].add(os.fsdecode(raw_path))

    if not object_paths:
        return []
    batch_input = ("\n".join(sorted(object_paths)) + "\n").encode("ascii")
    checked = git_output(
        ["cat-file", "--batch-check=%(objectname) %(objecttype) %(objectsize)"],
        batch_input,
    )
    blobs: list[HistoryBlob] = []
    for line in checked.splitlines():
        parts = line.decode("ascii").split(" ")
        if len(parts) != 3:
            raise ValueError("history object metadata is invalid")
        object_id, object_type, raw_size = parts
        if object_id not in object_paths or not raw_size.isdigit():
            raise ValueError("history object metadata is invalid")
        if object_type == "blob":
            blobs.append(
                HistoryBlob(
                    object_id=object_id,
                    size=int(raw_size),
                    paths=frozenset(object_paths[object_id]),
                )
            )
    return sorted(blobs, key=lambda blob: blob.object_id)


def evidence_paths(arguments: list[str], include_defaults: bool) -> tuple[list[Path], list[ScanError]]:
    requested = list(arguments)
    if include_defaults:
        requested.extend(path for path in DEFAULT_EVIDENCE if (REPO_ROOT / path).exists())

    files: set[Path] = set()
    errors: list[ScanError] = []
    for raw in requested:
        candidate = Path(raw)
        if not candidate.is_absolute():
            candidate = REPO_ROOT / candidate
        normalized = Path(os.path.abspath(candidate))
        label = safe_label(normalized)
        if not is_within_repo(normalized):
            errors.append(ScanError("evidence", label, "path_outside_repository"))
            continue
        if not normalized.exists():
            errors.append(ScanError("evidence", label, "path_missing"))
            continue
        if path_has_symlink(normalized):
            errors.append(ScanError("evidence", label, "symlink_rejected"))
            continue
        if normalized.is_file():
            files.add(normalized)
            continue
        if not normalized.is_dir():
            errors.append(ScanError("evidence", label, "unsupported_file_type"))
            continue

        def record_walk_error(_error: OSError) -> None:
            errors.append(
                ScanError("evidence", safe_label(normalized), "directory_read_failed")
            )

        for directory, directory_names, file_names in os.walk(
            normalized,
            followlinks=False,
            onerror=record_walk_error,
        ):
            directory_path = Path(directory)
            kept_directories = []
            for name in sorted(directory_names):
                child = directory_path / name
                if child.is_symlink():
                    errors.append(ScanError("evidence", safe_label(child), "symlink_rejected"))
                else:
                    kept_directories.append(name)
            directory_names[:] = kept_directories
            for name in sorted(file_names):
                child = directory_path / name
                if child.is_symlink():
                    errors.append(ScanError("evidence", safe_label(child), "symlink_rejected"))
                elif child.is_file():
                    files.add(child)
                else:
                    errors.append(ScanError("evidence", safe_label(child), "unsupported_file_type"))
    return sorted(files), errors


def match_is_allowed(
    source: str,
    rule: Rule,
    matched: bytes,
    raw_paths: frozenset[str],
    allowlist: dict[tuple[str, str, str, str], frozenset[str]],
    content_digest: str,
) -> bool:
    if source not in {"tracked", "history"} or not raw_paths:
        return False
    digest = hashlib.sha256(matched).hexdigest()
    allowed_paths = allowlist.get(
        (source, rule.identifier, digest, content_digest), frozenset()
    )
    return bool(allowed_paths) and raw_paths.issubset(allowed_paths)


def scan_content(
    content: bytes,
    source: str,
    label: str,
    rules: Iterable[Rule],
    allowlist: dict[tuple[str, str, str, str], frozenset[str]],
    raw_paths: frozenset[str],
) -> list[Finding]:
    findings: list[Finding] = []
    seen: set[tuple[str, int]] = set()
    content_digest = hashlib.sha256(content).hexdigest()
    for rule in rules:
        for match in rule.pattern.finditer(content):
            if match_is_allowed(
                source,
                rule,
                match.group(0),
                raw_paths,
                allowlist,
                content_digest,
            ):
                continue
            line = content.count(b"\n", 0, match.start()) + 1
            identity = (rule.identifier, line)
            if identity not in seen:
                seen.add(identity)
                findings.append(Finding(source, label, line, rule.identifier))
    return findings


def scan_file(
    path: Path,
    source: str,
    rules: Iterable[Rule],
    max_bytes: int,
    allowlist: dict[tuple[str, str, str, str], frozenset[str]],
) -> tuple[list[Finding], list[ScanError]]:
    label = safe_label(path)
    relative = repository_relative(path)
    raw_paths = frozenset({relative}) if relative is not None else frozenset()
    try:
        file_status = path.lstat()
    except OSError:
        return [], [ScanError(source, label, "metadata_unavailable")]
    if stat.S_ISLNK(file_status.st_mode):
        return [], [ScanError(source, label, "symlink_rejected")]
    if not stat.S_ISREG(file_status.st_mode):
        return [], [ScanError(source, label, "unsupported_file_type")]
    if file_status.st_size > max_bytes:
        return [], [ScanError(source, label, "file_too_large")]
    descriptor = -1
    try:
        descriptor = os.open(
            path,
            os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0),
        )
        opened_status = os.fstat(descriptor)
        if not stat.S_ISREG(opened_status.st_mode):
            return [], [ScanError(source, label, "unsupported_file_type")]
        if (file_status.st_dev, file_status.st_ino) != (
            opened_status.st_dev,
            opened_status.st_ino,
        ):
            return [], [ScanError(source, label, "file_changed_during_scan")]
        with os.fdopen(descriptor, "rb", closefd=True) as input_file:
            descriptor = -1
            content = input_file.read(max_bytes + 1)
    except OSError:
        return [], [ScanError(source, label, "read_failed")]
    finally:
        if descriptor >= 0:
            os.close(descriptor)
    if len(content) > max_bytes:
        return [], [ScanError(source, label, "file_too_large")]

    return scan_content(content, source, label, rules, allowlist, raw_paths), []


def scan_history_blob(
    blob: HistoryBlob,
    max_bytes: int,
    allowlist: dict[tuple[str, str, str, str], frozenset[str]],
) -> tuple[list[Finding], list[ScanError]]:
    label = "history-blob"
    if blob.size > max_bytes:
        return [], [ScanError("history", label, "object_too_large")]
    try:
        content = git_output(["cat-file", "blob", blob.object_id])
    except subprocess.SubprocessError:
        return [], [ScanError("history", label, "object_read_failed")]
    if len(content) != blob.size or len(content) > max_bytes:
        return [], [ScanError("history", label, "object_size_changed")]
    return (
        scan_content(content, "history", label, SECRET_RULES, allowlist, blob.paths),
        [],
    )


def tracked_name_findings(
    paths: Iterable[Path], ignored_paths: frozenset[str]
) -> list[Finding]:
    findings = []
    for path in paths:
        relative = repository_relative(path)
        if relative is None:
            findings.append(
                Finding("tracked", "outside-repository", 0, "repository.path_outside_repository")
            )
            continue
        lower_name = path.name.lower()
        lower_relative = relative.lower()
        if relative in ignored_paths:
            findings.append(
                Finding("tracked", safe_label(path), 0, "repository.tracked_ignored_path")
            )
        forbidden_environment = lower_name == ".env" or (
            lower_name.startswith(".env.") and lower_name != ".env.example"
        )
        forbidden_path = (
            lower_name in FORBIDDEN_TRACKED_NAMES
            or forbidden_environment
            or lower_name.endswith(FORBIDDEN_TRACKED_SUFFIXES)
            or lower_relative.startswith(FORBIDDEN_TRACKED_PREFIXES)
        )
        if forbidden_path:
            findings.append(
                Finding("tracked", safe_label(path), 0, "repository.forbidden_sensitive_path")
            )
    return findings


def write_report(
    raw_path: str,
    status: str,
    release_eligible: bool,
    metadata: RepositoryMetadata,
    coverage: dict[str, bool | int],
    tracked_count: int,
    history_count: int,
    evidence_count: int,
    findings: list[Finding],
    errors: list[ScanError],
) -> None:
    report_path = Path(raw_path)
    if not report_path.is_absolute():
        report_path = REPO_ROOT / report_path
    report_path = Path(os.path.abspath(report_path))
    if report_path.parent != REPORT_ROOT:
        raise ValueError("report path must be directly under reports/generated")
    if REPORT_ROOT.exists() and path_has_symlink(REPORT_ROOT):
        raise ValueError("report directory must not contain symlinks")
    reports_parent = REPORT_ROOT.parent
    try:
        reports_status = reports_parent.lstat()
    except OSError as error:
        raise ValueError("report parent is unavailable") from error
    if stat.S_ISLNK(reports_status.st_mode) or not stat.S_ISDIR(reports_status.st_mode):
        raise ValueError("report parent is unsafe")
    try:
        REPORT_ROOT.mkdir(mode=0o700)
    except FileExistsError:
        pass
    report_root_status = REPORT_ROOT.lstat()
    if path_has_symlink(REPORT_ROOT):
        raise ValueError("report directory must not contain symlinks")
    if not stat.S_ISDIR(report_root_status.st_mode):
        raise ValueError("report directory must be a directory")
    if stat.S_IMODE(report_root_status.st_mode) != 0o700:
        raise ValueError("report directory permissions must be 0700")
    if report_path.exists() and (report_path.is_symlink() or not report_path.is_file()):
        raise ValueError("report target must be a regular file")

    finding_counts = Counter(finding.rule_id for finding in findings)
    error_counts = Counter(error.error_id for error in errors)
    report = {
        "$schema": "../../docs/reports/leak-scan.schema.json",
        "schema_version": 2,
        "scanner_id": SCANNER_ID,
        "generated_at_utc": datetime.now(timezone.utc)
        .isoformat(timespec="seconds")
        .replace("+00:00", "Z"),
        "head_commit": metadata.head_commit,
        "clean_worktree": metadata.clean_worktree,
        "status": status,
        "release_eligible": release_eligible,
        "coverage": coverage,
        "tracked_files_scanned": tracked_count,
        "history_blobs_scanned": history_count,
        "evidence_files_scanned": evidence_count,
        "finding_counts": [
            {"rule_id": rule_id, "count": count}
            for rule_id, count in sorted(finding_counts.items())
        ],
        "scan_error_counts": [
            {"error_id": error_id, "count": count}
            for error_id, count in sorted(error_counts.items())
        ],
    }
    serialized = (json.dumps(report, indent=2, sort_keys=True) + "\n").encode("utf-8")
    descriptor, temporary_name = tempfile.mkstemp(prefix=".leak-scan-", dir=report_path.parent)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "wb", closefd=True) as output:
            output.write(serialized)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary_name, report_path)
    except BaseException:
        try:
            os.close(descriptor)
        except OSError:
            pass
        try:
            os.unlink(temporary_name)
        except OSError:
            pass
        raise


def main() -> int:
    arguments = parse_args()
    if arguments.rehearsal and not arguments.report:
        print("verify-no-leak: error=rehearsal_requires_report", file=sys.stderr)
        return 2
    try:
        initial_metadata = repository_metadata()
        allowlist = load_allowlist()
    except (OSError, ValueError, TypeError, KeyError, json.JSONDecodeError, subprocess.SubprocessError):
        print("verify-no-leak: error=repository_metadata_or_allowlist_invalid", file=sys.stderr)
        return 2

    findings: list[Finding] = []
    errors: list[ScanError] = []
    tracked: list[Path] = []
    if not arguments.no_tracked:
        try:
            tracked = tracked_paths()
            ignored = tracked_ignored_paths()
        except (OSError, subprocess.SubprocessError):
            print("verify-no-leak: error=git_inventory_failed", file=sys.stderr)
            return 2
        findings.extend(tracked_name_findings(tracked, ignored))
        for path in tracked:
            file_findings, file_errors = scan_file(
                path, "tracked", SECRET_RULES, arguments.max_bytes, allowlist
            )
            findings.extend(file_findings)
            errors.extend(file_errors)

    history_count = 0
    if not arguments.no_history:
        try:
            blobs = history_blobs()
        except (OSError, ValueError, UnicodeError, subprocess.SubprocessError):
            print("verify-no-leak: error=git_history_inventory_failed", file=sys.stderr)
            return 2
        for blob in blobs:
            blob_findings, blob_errors = scan_history_blob(
                blob, arguments.max_bytes, allowlist
            )
            findings.extend(blob_findings)
            errors.extend(blob_errors)
            if not blob_errors:
                history_count += 1

    evidence, evidence_errors = evidence_paths(
        arguments.evidence, not arguments.no_default_evidence
    )
    if arguments.report:
        report_path = Path(arguments.report)
        if not report_path.is_absolute():
            report_path = REPO_ROOT / report_path
        report_path = Path(os.path.abspath(report_path))
        evidence = [path for path in evidence if path != report_path]
    errors.extend(evidence_errors)
    for path in evidence:
        file_findings, file_errors = scan_file(
            path,
            "evidence",
            (*SECRET_RULES, *EVIDENCE_ONLY_RULES),
            arguments.max_bytes,
            {},
        )
        findings.extend(file_findings)
        errors.extend(file_errors)

    coverage: dict[str, bool | int] = {
        "tracked_worktree": not arguments.no_tracked,
        "git_history": not arguments.no_history,
        "generated_evidence": bool(evidence),
        "max_bytes_per_object": arguments.max_bytes,
    }
    release_requested = bool(arguments.report) and not arguments.rehearsal
    try:
        final_metadata = repository_metadata()
    except (OSError, ValueError, UnicodeError, subprocess.SubprocessError):
        print("verify-no-leak: error=repository_metadata_refresh_failed", file=sys.stderr)
        return 2
    repository_stable = initial_metadata.head_commit == final_metadata.head_commit
    metadata = RepositoryMetadata(
        head_commit=initial_metadata.head_commit,
        clean_worktree=(
            repository_stable
            and initial_metadata.clean_worktree
            and final_metadata.clean_worktree
        ),
    )
    if not repository_stable:
        errors.append(ScanError("release", "release-gate", "repository_head_changed"))
    if release_requested:
        if not metadata.clean_worktree:
            errors.append(ScanError("release", "release-gate", "dirty_worktree"))
        if arguments.no_tracked or not tracked:
            errors.append(ScanError("release", "release-gate", "tracked_coverage_missing"))
        if arguments.no_history or history_count == 0:
            errors.append(ScanError("release", "release-gate", "history_coverage_missing"))
        if not evidence:
            errors.append(ScanError("release", "release-gate", "evidence_coverage_missing"))

    findings.sort(key=lambda item: (item.source, item.path, item.line, item.rule_id))
    errors.sort(key=lambda item: (item.source, item.path, item.error_id))
    status = "pass" if not findings and not errors else "fail"
    release_eligible = bool(
        release_requested
        and status == "pass"
        and metadata.clean_worktree
        and tracked
        and history_count > 0
        and evidence
    )

    for finding in findings:
        print(
            "verify-no-leak: "
            f"finding source={finding.source} path={finding.path} "
            f"line={finding.line} rule={finding.rule_id}",
            file=sys.stderr,
        )
    for error in errors:
        print(
            "verify-no-leak: "
            f"scan_error source={error.source} path={error.path} error={error.error_id}",
            file=sys.stderr,
        )

    if arguments.report:
        try:
            write_report(
                arguments.report,
                status,
                release_eligible,
                metadata,
                coverage,
                len(tracked),
                history_count,
                len(evidence),
                findings,
                errors,
            )
        except (OSError, ValueError):
            print("verify-no-leak: error=report_write_failed", file=sys.stderr)
            return 2

    print(
        "verify-no-leak: "
        f"status={status} release_eligible={str(release_eligible).lower()} "
        f"tracked_files={len(tracked)} history_blobs={history_count} "
        f"evidence_files={len(evidence)} findings={len(findings)} scan_errors={len(errors)}"
    )
    return 0 if status == "pass" else 1


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        print("verify-no-leak: error=interrupted", file=sys.stderr)
        raise SystemExit(130) from None
    except Exception:
        print("verify-no-leak: error=internal_error", file=sys.stderr)
        raise SystemExit(2) from None
