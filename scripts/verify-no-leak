#!/usr/bin/env python3
"""Fail-closed, value-free leak scan for AgentVeil release evidence."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import stat
import subprocess
import sys
import tempfile
from collections import Counter
from dataclasses import dataclass
from pathlib import Path
from typing import Iterable


SCRIPT_PATH = Path(__file__).resolve()
REPO_ROOT = SCRIPT_PATH.parent.parent
DEFAULT_MAX_BYTES = 16 * 1024 * 1024
DEFAULT_EVIDENCE = ("runtime", "reports/generated")
ALLOWLIST_PATH = REPO_ROOT / "tests/fixtures/leak-manifest.json"
REPORT_ROOT = REPO_ROOT / "reports/generated"


@dataclass(frozen=True)
class Rule:
    identifier: str
    pattern: re.Pattern[bytes]


@dataclass(frozen=True)
class Finding:
    source: str
    path: str
    line: int
    rule_id: str


@dataclass(frozen=True)
class ScanError:
    source: str
    path: str
    error_id: str


SECRET_RULES = (
    Rule("secret.openai", re.compile(rb"\bsk-(?:proj-|svcacct-)?[A-Za-z0-9_-]{20,}\b")),
    Rule("secret.anthropic", re.compile(rb"\bsk-ant-[A-Za-z0-9_-]{20,}\b")),
    Rule("secret.github", re.compile(rb"\b(?:gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{40,})\b")),
    Rule("secret.aws_access_key", re.compile(rb"\b(?:AKIA|ASIA)[A-Z0-9]{16}\b")),
    Rule("secret.google_api", re.compile(rb"\bAIza[0-9A-Za-z_-]{35}\b")),
    Rule("secret.slack", re.compile(rb"\bxox[baprs]-[0-9A-Za-z-]{20,}\b")),
    Rule("secret.stripe_live", re.compile(rb"\b(?:sk|rk)_live_[0-9A-Za-z]{16,}\b")),
    Rule("secret.gitlab", re.compile(rb"\bglpat-[0-9A-Za-z_-]{20,}\b")),
    Rule("secret.huggingface", re.compile(rb"\bhf_[0-9A-Za-z]{30,}\b")),
    Rule("secret.npm", re.compile(rb"\bnpm_[0-9A-Za-z]{36}\b")),
    Rule("secret.pypi", re.compile(rb"\bpypi-[0-9A-Za-z_-]{50,}\b")),
    Rule(
        "secret.sendgrid",
        re.compile(rb"\bSG\.[0-9A-Za-z_-]{16,}\.[0-9A-Za-z_-]{20,}\b"),
    ),
    Rule("secret.age", re.compile(rb"\bAGE-SECRET-KEY-1[0-9A-Z]{40,}\b", re.IGNORECASE)),
    Rule(
        "secret.jwt",
        re.compile(rb"\beyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\b"),
    ),
    Rule(
        "secret.credentialed_database_url",
        re.compile(
            rb"\b(?:postgres(?:ql)?|mysql|mongodb(?:\+srv)?|redis)://[^\s/:@]{1,128}:[^\s/@]{1,256}@",
            re.IGNORECASE,
        ),
    ),
    Rule(
        "secret.bearer_literal",
        re.compile(rb"\bBearer[ \t]+[A-Za-z0-9._~+/=-]{20,}\b", re.IGNORECASE),
    ),
    Rule(
        "secret.generic_assignment",
        re.compile(
            rb"\b(?:api[_-]?key|client[_-]?secret|access[_-]?token|auth[_-]?token|password|passwd)\b"
            rb"[ \t]*[:=][ \t]*[\"']?[A-Za-z0-9+/=_-]{16,}",
            re.IGNORECASE,
        ),
    ),
    Rule(
        "secret.private_key_block",
        re.compile(
            rb"-----BEGIN (?:ENCRYPTED |RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----"
            rb"[\s\S]{64,16384}?"
            rb"-----END (?:ENCRYPTED |RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----"
        ),
    ),
)


EVIDENCE_ONLY_RULES = (
    Rule(
        "protected.email",
        re.compile(
            rb"(?<![A-Za-z0-9.!#$%&'*+/=?^_`{|}~-])"
            rb"[A-Za-z0-9.!#$%&'*+/=?^_`{|}~-]{1,64}"
            rb"@[A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?\.[A-Za-z]{2,63}"
        ),
    ),
    Rule(
        "protected.phone",
        re.compile(rb"(?<!\d)(?:\+?1[-. ]?)?\(?[2-9]\d{2}\)?[-. ]\d{3}[-. ]\d{4}(?!\d)"),
    ),
    Rule(
        "protected.private_ip",
        re.compile(
            rb"(?<!\d)(?:10(?:\.\d{1,3}){3}|192\.168(?:\.\d{1,3}){2}|172\.(?:1[6-9]|2\d|3[01])(?:\.\d{1,3}){2})(?!\d)"
        ),
    ),
    Rule(
        "protected.home_path",
        re.compile(rb"(?:/Users/|/home/)[A-Za-z0-9._-]{1,128}/"),
    ),
    Rule(
        "protected.internal_hostname",
        re.compile(rb"\b[A-Za-z0-9](?:[A-Za-z0-9-]{0,62}\.)+(?:internal|local|agentveil\.test)\b", re.IGNORECASE),
    ),
    Rule("protected.demo_custom_term", re.compile(rb"\bPROJECT-VEIL-DEMO\b")),
    Rule("protected.agentveil_token", re.compile(rb"\[AV_[A-Z0-9_]{8,}\]")),
    Rule(
        "secret.private_key_header",
        re.compile(rb"-----BEGIN (?:ENCRYPTED |RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----"),
    ),
)


FORBIDDEN_TRACKED_NAMES = frozenset(
    {
        ".env",
        "auth.json",
        "credentials.json",
        "id_dsa",
        "id_ecdsa",
        "id_ed25519",
        "id_rsa",
    }
)
FORBIDDEN_TRACKED_SUFFIXES = (".key", ".p12", ".pfx", ".pem", ".ledger", ".capture")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Scan tracked files and repository-local runtime evidence without ever "
            "printing matched values."
        )
    )
    parser.add_argument(
        "--evidence",
        action="append",
        default=[],
        metavar="PATH",
        help="repository-local evidence file or directory; may be repeated",
    )
    parser.add_argument(
        "--no-default-evidence",
        action="store_true",
        help="do not scan runtime/ and reports/generated/ when they exist",
    )
    parser.add_argument(
        "--no-tracked",
        action="store_true",
        help="skip Git tracked files (not valid for a release gate)",
    )
    parser.add_argument(
        "--max-bytes",
        type=positive_integer,
        default=DEFAULT_MAX_BYTES,
        help=f"maximum bytes per file before failing closed (default: {DEFAULT_MAX_BYTES})",
    )
    parser.add_argument(
        "--report",
        metavar="PATH",
        help="write a value-free JSON report inside this repository",
    )
    return parser.parse_args()


def positive_integer(raw: str) -> int:
    try:
        value = int(raw)
    except ValueError as error:
        raise argparse.ArgumentTypeError("must be an integer") from error
    if value <= 0:
        raise argparse.ArgumentTypeError("must be greater than zero")
    return value


def safe_label(path: Path) -> str:
    try:
        relative = path.relative_to(REPO_ROOT)
    except ValueError:
        return "outside-repository"
    return relative.as_posix().encode("unicode_escape").decode("ascii")


def is_within_repo(path: Path) -> bool:
    try:
        path.relative_to(REPO_ROOT)
    except ValueError:
        return False
    return True


def path_has_symlink(path: Path) -> bool:
    try:
        relative = path.relative_to(REPO_ROOT)
    except ValueError:
        return True
    cursor = REPO_ROOT
    for component in relative.parts:
        cursor = cursor / component
        if cursor.is_symlink():
            return True
    return False


def load_allowlist() -> dict[tuple[str, str], frozenset[str]]:
    if not ALLOWLIST_PATH.exists():
        return {}
    if ALLOWLIST_PATH.is_symlink():
        raise ValueError("allowlist is a symlink")
    document = json.loads(ALLOWLIST_PATH.read_text(encoding="utf-8"))
    if document.get("version") != 1 or set(document) != {"version", "allow_tracked_matches"}:
        raise ValueError("allowlist schema is invalid")

    allowed: dict[tuple[str, str], set[str]] = {}
    for entry in document["allow_tracked_matches"]:
        if set(entry) != {"rule_id", "sha256", "paths"}:
            raise ValueError("allowlist entry schema is invalid")
        rule_id = entry["rule_id"]
        digest = entry["sha256"]
        paths = entry["paths"]
        if not isinstance(rule_id, str) or not re.fullmatch(r"[a-z0-9_.]+", rule_id):
            raise ValueError("allowlist rule identifier is invalid")
        if not isinstance(digest, str) or not re.fullmatch(r"[0-9a-f]{64}", digest):
            raise ValueError("allowlist digest is invalid")
        if not isinstance(paths, list) or not paths:
            raise ValueError("allowlist paths are invalid")
        key = (rule_id, digest)
        for path in paths:
            if not isinstance(path, str) or path.startswith(("/", "../")) or "/../" in path:
                raise ValueError("allowlist path is invalid")
            allowed.setdefault(key, set()).add(path)
    return {key: frozenset(paths) for key, paths in allowed.items()}


def tracked_paths() -> list[Path]:
    result = subprocess.run(
        ["git", "-C", str(REPO_ROOT), "ls-files", "-z", "--cached"],
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    return sorted((REPO_ROOT / os.fsdecode(raw) for raw in result.stdout.split(b"\0") if raw))


def evidence_paths(arguments: list[str], include_defaults: bool) -> tuple[list[Path], list[ScanError]]:
    requested = list(arguments)
    if include_defaults:
        requested.extend(path for path in DEFAULT_EVIDENCE if (REPO_ROOT / path).exists())

    files: set[Path] = set()
    errors: list[ScanError] = []
    for raw in requested:
        candidate = Path(raw)
        if not candidate.is_absolute():
            candidate = REPO_ROOT / candidate
        normalized = Path(os.path.abspath(candidate))
        label = safe_label(normalized)
        if not is_within_repo(normalized):
            errors.append(ScanError("evidence", label, "path_outside_repository"))
            continue
        if not normalized.exists():
            errors.append(ScanError("evidence", label, "path_missing"))
            continue
        if path_has_symlink(normalized):
            errors.append(ScanError("evidence", label, "symlink_rejected"))
            continue
        if normalized.is_file():
            files.add(normalized)
            continue
        if not normalized.is_dir():
            errors.append(ScanError("evidence", label, "unsupported_file_type"))
            continue

        for directory, directory_names, file_names in os.walk(normalized, followlinks=False):
            directory_path = Path(directory)
            kept_directories = []
            for name in sorted(directory_names):
                child = directory_path / name
                if child.is_symlink():
                    errors.append(ScanError("evidence", safe_label(child), "symlink_rejected"))
                else:
                    kept_directories.append(name)
            directory_names[:] = kept_directories
            for name in sorted(file_names):
                child = directory_path / name
                if child.is_symlink():
                    errors.append(ScanError("evidence", safe_label(child), "symlink_rejected"))
                elif child.is_file():
                    files.add(child)
                else:
                    errors.append(ScanError("evidence", safe_label(child), "unsupported_file_type"))
    return sorted(files), errors


def scan_file(
    path: Path,
    source: str,
    rules: Iterable[Rule],
    max_bytes: int,
    allowlist: dict[tuple[str, str], frozenset[str]],
) -> tuple[list[Finding], list[ScanError]]:
    label = safe_label(path)
    try:
        file_status = path.lstat()
    except OSError:
        return [], [ScanError(source, label, "metadata_unavailable")]
    if stat.S_ISLNK(file_status.st_mode):
        return [], [ScanError(source, label, "symlink_rejected")]
    if not stat.S_ISREG(file_status.st_mode):
        return [], [ScanError(source, label, "unsupported_file_type")]
    if file_status.st_size > max_bytes:
        return [], [ScanError(source, label, "file_too_large")]
    descriptor = -1
    try:
        descriptor = os.open(
            path,
            os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0),
        )
        opened_status = os.fstat(descriptor)
        if not stat.S_ISREG(opened_status.st_mode):
            return [], [ScanError(source, label, "unsupported_file_type")]
        with os.fdopen(descriptor, "rb", closefd=True) as input_file:
            descriptor = -1
            content = input_file.read(max_bytes + 1)
    except OSError:
        return [], [ScanError(source, label, "read_failed")]
    finally:
        if descriptor >= 0:
            os.close(descriptor)
    if len(content) > max_bytes:
        return [], [ScanError(source, label, "file_too_large")]

    findings: list[Finding] = []
    seen: set[tuple[str, int]] = set()
    for rule in rules:
        for match in rule.pattern.finditer(content):
            if source == "tracked":
                digest = hashlib.sha256(match.group(0)).hexdigest()
                if label in allowlist.get((rule.identifier, digest), frozenset()):
                    continue
            line = content.count(b"\n", 0, match.start()) + 1
            identity = (rule.identifier, line)
            if identity not in seen:
                seen.add(identity)
                findings.append(Finding(source, label, line, rule.identifier))
    return findings, []


def tracked_name_findings(paths: Iterable[Path]) -> list[Finding]:
    findings = []
    for path in paths:
        lower_name = path.name.lower()
        if lower_name in FORBIDDEN_TRACKED_NAMES or lower_name.endswith(FORBIDDEN_TRACKED_SUFFIXES):
            findings.append(Finding("tracked", safe_label(path), 0, "repository.forbidden_sensitive_filename"))
    return findings


def write_report(
    raw_path: str,
    status: str,
    tracked_count: int,
    evidence_count: int,
    findings: list[Finding],
    errors: list[ScanError],
) -> None:
    report_path = Path(raw_path)
    if not report_path.is_absolute():
        report_path = REPO_ROOT / report_path
    report_path = Path(os.path.abspath(report_path))
    if report_path.parent != REPORT_ROOT:
        raise ValueError("report path must be directly under reports/generated")
    if REPORT_ROOT.exists() and path_has_symlink(REPORT_ROOT):
        raise ValueError("report directory must not contain symlinks")
    REPORT_ROOT.mkdir(mode=0o700, parents=True, exist_ok=True)
    if path_has_symlink(REPORT_ROOT):
        raise ValueError("report directory must not contain symlinks")
    if report_path.exists() and (report_path.is_symlink() or not report_path.is_file()):
        raise ValueError("report target must be a regular file")

    finding_counts = Counter(finding.rule_id for finding in findings)
    error_counts = Counter(error.error_id for error in errors)
    report = {
        "$schema": "../../docs/reports/leak-scan.schema.json",
        "schema_version": 1,
        "status": status,
        "tracked_files_scanned": tracked_count,
        "evidence_files_scanned": evidence_count,
        "finding_counts": [
            {"rule_id": rule_id, "count": count}
            for rule_id, count in sorted(finding_counts.items())
        ],
        "scan_error_counts": [
            {"error_id": error_id, "count": count}
            for error_id, count in sorted(error_counts.items())
        ],
    }
    serialized = (json.dumps(report, indent=2, sort_keys=True) + "\n").encode("utf-8")
    descriptor, temporary_name = tempfile.mkstemp(prefix=".leak-scan-", dir=report_path.parent)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "wb", closefd=True) as output:
            output.write(serialized)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary_name, report_path)
    except BaseException:
        try:
            os.close(descriptor)
        except OSError:
            pass
        try:
            os.unlink(temporary_name)
        except OSError:
            pass
        raise


def main() -> int:
    arguments = parse_args()
    try:
        allowlist = load_allowlist()
    except (OSError, ValueError, json.JSONDecodeError):
        print("verify-no-leak: error=allowlist_invalid", file=sys.stderr)
        return 2

    findings: list[Finding] = []
    errors: list[ScanError] = []
    tracked: list[Path] = []
    if not arguments.no_tracked:
        try:
            tracked = tracked_paths()
        except (OSError, subprocess.SubprocessError):
            print("verify-no-leak: error=git_inventory_failed", file=sys.stderr)
            return 2
        findings.extend(tracked_name_findings(tracked))
        for path in tracked:
            file_findings, file_errors = scan_file(
                path, "tracked", SECRET_RULES, arguments.max_bytes, allowlist
            )
            findings.extend(file_findings)
            errors.extend(file_errors)

    evidence, evidence_errors = evidence_paths(
        arguments.evidence, not arguments.no_default_evidence
    )
    errors.extend(evidence_errors)
    for path in evidence:
        file_findings, file_errors = scan_file(
            path,
            "evidence",
            (*SECRET_RULES, *EVIDENCE_ONLY_RULES),
            arguments.max_bytes,
            {},
        )
        findings.extend(file_findings)
        errors.extend(file_errors)

    findings.sort(key=lambda item: (item.source, item.path, item.line, item.rule_id))
    errors.sort(key=lambda item: (item.source, item.path, item.error_id))
    status = "pass" if not findings and not errors else "fail"

    for finding in findings:
        print(
            "verify-no-leak: "
            f"finding source={finding.source} path={finding.path} "
            f"line={finding.line} rule={finding.rule_id}",
            file=sys.stderr,
        )
    for error in errors:
        print(
            "verify-no-leak: "
            f"scan_error source={error.source} path={error.path} error={error.error_id}",
            file=sys.stderr,
        )

    if arguments.report:
        try:
            write_report(
                arguments.report,
                status,
                len(tracked),
                len(evidence),
                findings,
                errors,
            )
        except (OSError, ValueError):
            print("verify-no-leak: error=report_write_failed", file=sys.stderr)
            return 2

    print(
        "verify-no-leak: "
        f"status={status} tracked_files={len(tracked)} evidence_files={len(evidence)} "
        f"findings={len(findings)} scan_errors={len(errors)}"
    )
    return 0 if status == "pass" else 1


if __name__ == "__main__":
    raise SystemExit(main())
