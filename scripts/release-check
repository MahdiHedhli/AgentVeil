#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd -P)"
cd "$ROOT_DIR"

ALLOW_DIRTY=0
ALLOW_MISSING_CARGO_AUDIT=0
while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --allow-dirty)
      ALLOW_DIRTY=1
      ;;
    --allow-missing-cargo-audit)
      ALLOW_MISSING_CARGO_AUDIT=1
      ;;
    *)
      printf '%s\n' \
        'usage: scripts/release-check [--allow-dirty] [--allow-missing-cargo-audit]' >&2
      exit 2
      ;;
  esac
  shift
done

RELEASE_ELIGIBLE=1
if [[ "$ALLOW_DIRTY" -eq 1 || "$ALLOW_MISSING_CARGO_AUDIT" -eq 1 ]]; then
  RELEASE_ELIGIBLE=0
fi

export CARGO_TERM_COLOR=never
export RUST_BACKTRACE=0
export RUST_TEST_THREADS=1
umask 077

STEP_COUNT=0
run_quiet() {
  local step_id="$1"
  shift
  STEP_COUNT=$((STEP_COUNT + 1))
  printf 'release-check: step=%s status=running\n' "$step_id"
  if "$@" >/dev/null 2>&1; then
    printf 'release-check: step=%s status=pass\n' "$step_id"
    return 0
  else
    local exit_status=$?
    printf 'release-check: step=%s status=fail output=suppressed\n' "$step_id" >&2
    return "$exit_status"
  fi
}

fail_check() {
  local check_id="$1"
  printf 'release-check: step=%s status=fail\n' "$check_id" >&2
  exit 1
}

pass_check() {
  local check_id="$1"
  STEP_COUNT=$((STEP_COUNT + 1))
  printf 'release-check: step=%s status=pass\n' "$check_id"
}

EVIDENCE_DIR='reports/generated'
DEMO_EVIDENCE="$EVIDENCE_DIR/release-demo-check.txt"
LEAK_REPORT="$EVIDENCE_DIR/release-leak-scan.json"
DEMO_EXPECTED='demo-check: status=pass route=synthetic_loopback allow=pass tokenize=pass zero_connect=pass tool_reentry=pass dashboard=pass audit=pass output=value_free'
CODEX_COMPATIBLE_EXPECTED='codex-demo-check: status=pass route=synthetic_client_codex_compatible block=pass tokenize=pass restore_delta=pass replay=pass wire_proof=pass audit=pass output=value_free'

prepare_evidence_directory() {
  if [[ -L reports || ! -d reports ]]; then
    fail_check "evidence_parent"
  fi
  if [[ -e "$EVIDENCE_DIR" && ( -L "$EVIDENCE_DIR" || ! -d "$EVIDENCE_DIR" ) ]]; then
    fail_check "evidence_directory"
  fi
  if [[ ! -e "$EVIDENCE_DIR" ]]; then
    mkdir "$EVIDENCE_DIR" || fail_check "evidence_directory"
  fi
  if [[ -L "$EVIDENCE_DIR" || ! -d "$EVIDENCE_DIR" ]]; then
    fail_check "evidence_directory"
  fi
  if ! python3 -c '
import os
import stat
import sys

metadata = os.lstat(sys.argv[1])
valid = (
    stat.S_ISDIR(metadata.st_mode)
    and not stat.S_ISLNK(metadata.st_mode)
    and stat.S_IMODE(metadata.st_mode) == 0o700
)
raise SystemExit(0 if valid else 1)
' "$EVIDENCE_DIR"; then
    fail_check "evidence_directory_permissions"
  fi
  pass_check "evidence_directory"
}

capture_demo_evidence() {
  local temporary_output
  STEP_COUNT=$((STEP_COUNT + 1))
  printf '%s\n' 'release-check: step=demo_check status=running'
  temporary_output="$(mktemp "$EVIDENCE_DIR/.demo-check.XXXXXX")" \
    || fail_check "demo_evidence_create"
  chmod 600 "$temporary_output"
  if ! scripts/demo-check >"$temporary_output" 2>&1; then
    rm -f "$temporary_output"
    printf '%s\n' 'release-check: step=demo_check status=fail output=suppressed' >&2
    exit 1
  fi
  if ! printf '%s\n' "$DEMO_EXPECTED" "$CODEX_COMPATIBLE_EXPECTED" \
    | cmp -s - "$temporary_output"; then
    rm -f "$temporary_output"
    printf '%s\n' 'release-check: step=demo_check status=fail output=unexpected' >&2
    exit 1
  fi
  if [[ -L "$DEMO_EVIDENCE" || ( -e "$DEMO_EVIDENCE" && ! -f "$DEMO_EVIDENCE" ) ]]; then
    rm -f "$temporary_output"
    fail_check "demo_evidence_target"
  fi
  mv -f "$temporary_output" "$DEMO_EVIDENCE"
  chmod 600 "$DEMO_EVIDENCE"
  printf '%s\n' 'release-check: step=demo_check status=pass evidence=value_free'
}

validate_leak_report() {
  local expected_release_eligible="$1"
  run_quiet \
    "leak_report_validate" \
    python3 -c '
import json
import os
import stat
import sys

path, expected_eligible, expected_head = sys.argv[1:]
if os.path.islink(path):
    raise SystemExit(1)
with open(path, encoding="utf-8") as handle:
    report = json.load(handle)
coverage = report.get("coverage", {})
valid = (
    report.get("schema_version") == 2
    and report.get("scanner_id") == "agentveil-verify-no-leak-v2"
    and report.get("head_commit") == expected_head
    and report.get("status") == "pass"
    and report.get("release_eligible") is (expected_eligible == "true")
    and isinstance(report.get("generated_at_utc"), str)
    and report.get("finding_counts") == []
    and report.get("scan_error_counts") == []
    and report.get("tracked_files_scanned", 0) > 0
    and report.get("history_blobs_scanned", 0) > 0
    and report.get("evidence_files_scanned", 0) > 0
    and coverage.get("tracked_worktree") is True
    and coverage.get("git_history") is True
    and coverage.get("generated_evidence") is True
    and type(coverage.get("max_bytes_per_object")) is int
    and coverage.get("max_bytes_per_object", 0) > 0
    and stat.S_IMODE(os.stat(path).st_mode) == 0o600
)
if expected_eligible == "true":
    valid = valid and report.get("clean_worktree") is True
raise SystemExit(0 if valid else 1)
' "$LEAK_REPORT" "$expected_release_eligible" "$RELEASE_HEAD"
}

verify_repository_stable() {
  local current_head
  current_head="$(git rev-parse --verify HEAD)" || fail_check "repository_head"
  if [[ "$current_head" != "$RELEASE_HEAD" ]]; then
    fail_check "repository_head_changed"
  fi
  if [[ "$RELEASE_ELIGIBLE" -eq 1 \
    && -n "$(git status --porcelain=v1 --untracked-files=all)" ]]; then
    fail_check "repository_became_dirty"
  fi
  pass_check "repository_stable"
}

RELEASE_HEAD="$(git rev-parse --verify HEAD)" || fail_check "repository_head"
if [[ ! "$RELEASE_HEAD" =~ ^[0-9a-f]{40,64}$ ]]; then
  fail_check "repository_head"
fi

required_files=(
  .github/workflows/release.yml
  AGENTS.md
  Cargo.lock
  Cargo.toml
  LICENSE
  NOTICE
  README.md
  SECURITY.md
  docs/ARCHITECTURE.md
  docs/CODEX_PAYLOAD_MAP.md
  docs/DEMO.md
  docs/DONOR_ATTRIBUTION.md
  docs/INSTALL.md
  docs/JUDGE_TEST.md
  docs/LIMITATIONS.md
  docs/PRIVACY.md
  docs/reports/benchmark.md
  docs/reports/benchmark.schema.json
  docs/reports/benchmark.template.json
  docs/reports/README.md
  docs/reports/leak-scan.schema.json
  docs/reports/leak-scan.template.json
  docs/SECURITY_INVARIANTS.md
  docs/THREAT_MODEL.md
  fixtures/demo/synthetic-context.txt
  policies/default.yaml
  policies/demo.yaml
  policies/strict.yaml
  reports/README.md
  scripts/benchmark
  scripts/demo-check
  scripts/package-release
  scripts/release-check
  scripts/verify-no-leak
  tests/test_release_scripts.py
)

for required_file in "${required_files[@]}"; do
  if [[ ! -f "$required_file" || -L "$required_file" || ! -s "$required_file" ]]; then
    fail_check "required_file"
  fi
done
pass_check "required_files"

if [[ ! -x scripts/benchmark \
  || ! -x scripts/demo-check \
  || ! -x scripts/package-release \
  || ! -x scripts/release-check \
  || ! -x scripts/verify-no-leak ]]; then
  fail_check "script_permissions"
fi
pass_check "script_permissions"

if ! grep -Fq 'Apache License' LICENSE \
  || ! grep -Fq 'Version 2.0, January 2004' LICENSE \
  || ! grep -Eq '^license = "Apache-2\.0"$' Cargo.toml \
  || ! grep -Fq 'PromptFence' NOTICE \
  || ! grep -Fq 'PromptGuard' NOTICE \
  || ! grep -Fq 'PromptGate' NOTICE \
  || ! grep -Fq 'PromptFence' docs/DONOR_ATTRIBUTION.md \
  || ! grep -Fq 'PromptGuard' docs/DONOR_ATTRIBUTION.md \
  || ! grep -Fq 'PromptGate' docs/DONOR_ATTRIBUTION.md; then
  fail_check "license_attribution"
fi
pass_check "license_attribution"

if ! grep -Fqx '/runtime/' .gitignore \
  || ! grep -Fqx '/reports/generated/' .gitignore \
  || ! grep -Fqx '.env' .gitignore \
  || ! grep -Fqx '*.audit.jsonl' .gitignore \
  || ! grep -Fq 'unsafe_code = "forbid"' Cargo.toml \
  || ! grep -Fq 'raw_logging: false' policies/default.yaml \
  || ! grep -Fq 'raw_logging: false' policies/demo.yaml \
  || ! grep -Fq 'raw_logging: false' policies/strict.yaml \
  || ! grep -Fq 'actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd' .github/workflows/release.yml \
  || ! grep -Fq 'SECURITY.md' scripts/package-release \
  || ! grep -Fq 'STATUS.md' scripts/package-release \
  || ! grep -Fq 'docs/DONOR_ATTRIBUTION.md' scripts/package-release \
  || ! grep -Fq 'scripts/package-release' .github/workflows/release.yml \
  || ! grep -Fq '6d6e4246fcdfe0c19f19f696e8c64ed1432c58665718b28269ca61a8a69cc735' scripts/package-release \
  || ! grep -Fq 'persist-credentials: false' .github/workflows/release.yml; then
  fail_check "security_configuration"
fi
pass_check "security_configuration"
run_quiet "package_harness_inventory" scripts/package-release --help
run_quiet "benchmark_harness_inventory" scripts/benchmark --help
run_quiet \
  "release_script_tests" \
  python3 -m unittest discover -s tests -p 'test_*.py'

if [[ "$ALLOW_DIRTY" -eq 0 ]]; then
  if [[ -n "$(git status --porcelain=v1 --untracked-files=all)" ]]; then
    fail_check "clean_worktree"
  fi
  pass_check "clean_worktree"
else
  printf '%s\n' 'release-check: step=clean_worktree status=skipped reason=allow_dirty'
fi

run_quiet "diff_unstaged" git diff --check
run_quiet "diff_staged" git diff --cached --check
run_quiet "format" cargo fmt --all -- --check
run_quiet \
  "clippy_strict" \
  cargo clippy --locked --all-targets --all-features -- \
  -D warnings \
  -D clippy::dbg_macro \
  -D clippy::expect_used \
  -D clippy::panic \
  -D clippy::todo \
  -D clippy::unimplemented \
  -D clippy::unwrap_used
run_quiet "tests_all" cargo test --locked --all-targets --all-features
run_quiet "binary_release" cargo build --locked --release --bin agentveil

shopt -s nullglob
policy_files=(policies/*.yaml)
if [[ "${#policy_files[@]}" -eq 0 ]]; then
  fail_check "policy_inventory"
fi
for policy_file in "${policy_files[@]}"; do
  run_quiet "policy_validate" target/release/agentveil policy-validate "$policy_file"
done

if command -v cargo-audit >/dev/null 2>&1; then
  run_quiet "dependency_advisories" cargo audit
elif [[ "$ALLOW_MISSING_CARGO_AUDIT" -eq 1 ]]; then
  printf '%s\n' 'release-check: step=dependency_advisories status=skipped reason=explicit_override'
else
  fail_check "dependency_advisories_tool_unavailable"
fi

prepare_evidence_directory
capture_demo_evidence

leak_scan_arguments=(--report "$LEAK_REPORT")
if [[ "$RELEASE_ELIGIBLE" -eq 0 ]]; then
  leak_scan_arguments+=(--rehearsal)
fi
run_quiet "leak_scan" scripts/verify-no-leak "${leak_scan_arguments[@]}"
verify_repository_stable

if [[ "$RELEASE_ELIGIBLE" -eq 1 ]]; then
  validate_leak_report true
  printf 'release-check: status=pass release_eligible=true steps=%s\n' "$STEP_COUNT"
else
  validate_leak_report false
  printf 'release-check: status=rehearsal release_eligible=false steps=%s\n' "$STEP_COUNT"
fi
