#!/usr/bin/env python3
"""Run value-free, offline AgentVeil benchmark scenarios.

The harness measures complete release-test process iterations. It intentionally
does not report request bodies, protected values, tokens, mappings, command
lines, environment values, hostnames, or absolute paths.
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import math
import os
import re
import stat
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Final


SCRIPT_PATH: Final = Path(__file__).resolve()
REPO_ROOT: Final = SCRIPT_PATH.parent.parent
REPORT_ROOT: Final = REPO_ROOT / "reports/generated"
SCHEMA_REFERENCE: Final = "../../docs/reports/benchmark.schema.json"
SAFE_IDENTIFIER: Final = re.compile(r"^[a-z][a-z0-9_]{2,63}$")
SAFE_SEMVER: Final = re.compile(r"^[0-9]+\.[0-9]+\.[0-9]+$")
SAFE_GIT_SHA: Final = re.compile(r"^(?:[0-9a-f]{40}|[0-9a-f]{64})$")
MAX_ITERATIONS: Final = 200
MAX_WARMUP: Final = 50
DEFAULT_ITERATIONS: Final = 25
DEFAULT_WARMUP: Final = 3
MAX_TIMEOUT_SECONDS: Final = 300
MAX_GIT_STATUS_BYTES: Final = 1024 * 1024


class BenchmarkError(Exception):
    """An expected failure identified only by a safe, stable reason code."""

    def __init__(self, reason: str) -> None:
        if not SAFE_IDENTIFIER.fullmatch(reason):
            reason = "internal_error"
        self.reason = reason
        super().__init__(reason)


class SafeArgumentParser(argparse.ArgumentParser):
    """Avoid reflecting arbitrary argument values into terminal output."""

    def error(self, message: str) -> None:  # noqa: ARG002
        self.print_usage(sys.stderr)
        print("benchmark: status=fail reason=invalid_arguments", file=sys.stderr)
        raise SystemExit(2)


@dataclass(frozen=True)
class Scenario:
    identifier: str
    measurement_target: str
    command: tuple[str, ...]
    expected_test: str


SCENARIOS: Final = (
    Scenario(
        identifier="library_protect_restore",
        measurement_target="release_test_process_wall_clock",
        command=(
            "cargo",
            "test",
            "--quiet",
            "--locked",
            "--offline",
            "--release",
            "--lib",
            "engine::tests::tokenizes_then_restores_email_and_private_ip",
            "--",
            "--exact",
        ),
        expected_test="engine::tests::tokenizes_then_restores_email_and_private_ip",
    ),
    Scenario(
        identifier="gateway_wire_proof",
        measurement_target="release_test_process_wall_clock",
        command=(
            "cargo",
            "test",
            "--quiet",
            "--locked",
            "--offline",
            "--release",
            "--test",
            "gateway_e2e",
            "wire_proof_tokenizes_blocks_restores_and_keeps_audit_value_free",
            "--",
            "--exact",
        ),
        expected_test="wire_proof_tokenizes_blocks_restores_and_keeps_audit_value_free",
    ),
)


def bounded_integer(minimum: int, maximum: int):
    def parse(raw: str) -> int:
        try:
            value = int(raw)
        except ValueError as error:
            raise argparse.ArgumentTypeError from error
        if value < minimum or value > maximum:
            raise argparse.ArgumentTypeError
        return value

    return parse


def parse_args() -> argparse.Namespace:
    parser = SafeArgumentParser(
        description=(
            "Measure synthetic AgentVeil release-test iterations offline and emit "
            "only aggregate, value-free results."
        )
    )
    parser.add_argument(
        "--scenario",
        choices=("all", "library", "gateway"),
        default="all",
        help="scenario set to measure (default: all)",
    )
    parser.add_argument(
        "--iterations",
        type=bounded_integer(1, MAX_ITERATIONS),
        default=DEFAULT_ITERATIONS,
        help=(
            f"measured iterations per scenario, 1-{MAX_ITERATIONS} "
            f"(default: {DEFAULT_ITERATIONS})"
        ),
    )
    parser.add_argument(
        "--warmup",
        type=bounded_integer(0, MAX_WARMUP),
        default=DEFAULT_WARMUP,
        help=(
            f"unmeasured warmup iterations per scenario, 0-{MAX_WARMUP} "
            f"(default: {DEFAULT_WARMUP})"
        ),
    )
    parser.add_argument(
        "--timeout-seconds",
        type=bounded_integer(1, MAX_TIMEOUT_SECONDS),
        default=120,
        help=(
            "per-command timeout in seconds, "
            f"1-{MAX_TIMEOUT_SECONDS} (default: 120)"
        ),
    )
    parser.add_argument(
        "--report",
        default="reports/generated/benchmark.json",
        metavar="RELATIVE_PATH",
        help="direct child JSON path under reports/generated/",
    )
    parser.add_argument(
        "--no-report",
        action="store_true",
        help="validate results without writing a JSON report",
    )
    return parser.parse_args()


def selected_scenarios(selection: str) -> tuple[Scenario, ...]:
    if selection == "library":
        return (SCENARIOS[0],)
    if selection == "gateway":
        return (SCENARIOS[1],)
    return SCENARIOS


def benchmark_environment() -> dict[str, str]:
    allowed = (
        "PATH",
        "HOME",
        "TMPDIR",
        "TMP",
        "TEMP",
        "LANG",
        "LC_ALL",
        "CARGO_HOME",
        "RUSTUP_HOME",
        "SDKROOT",
        "DEVELOPER_DIR",
    )
    environment = {key: os.environ[key] for key in allowed if key in os.environ}
    environment.update(
        {
            "CARGO_NET_OFFLINE": "true",
            "CARGO_TERM_COLOR": "never",
            "GIT_OPTIONAL_LOCKS": "0",
            "GIT_PAGER": "cat",
            "LC_ALL": "C",
            "RUST_BACKTRACE": "0",
            "RUST_TEST_THREADS": "1",
        }
    )
    return environment


def run_hidden(
    command: tuple[str, ...],
    environment: dict[str, str],
    timeout_seconds: int,
) -> int:
    started_ns = time.perf_counter_ns()
    try:
        result = subprocess.run(
            command,
            cwd=REPO_ROOT,
            env=environment,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
            timeout=timeout_seconds,
        )
    except subprocess.TimeoutExpired as error:
        raise BenchmarkError("command_timeout") from error
    except OSError as error:
        raise BenchmarkError("command_unavailable") from error
    elapsed_ns = time.perf_counter_ns() - started_ns
    if result.returncode != 0:
        raise BenchmarkError("scenario_failed")
    if elapsed_ns <= 0:
        raise BenchmarkError("invalid_measurement")
    return elapsed_ns


def verify_exact_test(
    scenario: Scenario,
    environment: dict[str, str],
    timeout_seconds: int,
) -> None:
    listing_command = (*scenario.command, "--list")
    try:
        result = subprocess.run(
            listing_command,
            cwd=REPO_ROOT,
            env=environment,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            check=False,
            timeout=timeout_seconds,
        )
    except subprocess.TimeoutExpired as error:
        raise BenchmarkError("test_inventory_timeout") from error
    except OSError as error:
        raise BenchmarkError("command_unavailable") from error
    if result.returncode != 0 or len(result.stdout) > 4096:
        raise BenchmarkError("test_inventory_failed")
    try:
        lines = result.stdout.decode("utf-8", errors="strict").splitlines()
    except UnicodeDecodeError as error:
        raise BenchmarkError("test_inventory_malformed") from error
    expected_line = f"{scenario.expected_test}: test"
    if lines != [expected_line]:
        raise BenchmarkError("test_inventory_malformed")


def tool_semver(
    executable: str,
    environment: dict[str, str],
    timeout_seconds: int,
) -> str:
    try:
        result = subprocess.run(
            (executable, "--version"),
            cwd=REPO_ROOT,
            env=environment,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            check=False,
            timeout=timeout_seconds,
        )
    except (subprocess.TimeoutExpired, OSError) as error:
        raise BenchmarkError("toolchain_unavailable") from error
    if result.returncode != 0 or len(result.stdout) > 256:
        raise BenchmarkError("toolchain_unavailable")
    try:
        fields = result.stdout.decode("ascii", errors="strict").split()
    except UnicodeDecodeError as error:
        raise BenchmarkError("toolchain_malformed") from error
    if len(fields) < 2 or fields[0] != executable or not SAFE_SEMVER.fullmatch(fields[1]):
        raise BenchmarkError("toolchain_malformed")
    return fields[1]


def git_metadata(
    environment: dict[str, str], timeout_seconds: int
) -> tuple[str, bool]:
    try:
        revision = subprocess.run(
            ("git", "rev-parse", "--verify", "HEAD"),
            cwd=REPO_ROOT,
            env=environment,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            check=False,
            timeout=timeout_seconds,
        )
        worktree = subprocess.run(
            (
                "git",
                "status",
                "--porcelain=v1",
                "-z",
                "--untracked-files=all",
                "--ignore-submodules=none",
            ),
            cwd=REPO_ROOT,
            env=environment,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            check=False,
            timeout=timeout_seconds,
        )
    except subprocess.TimeoutExpired as error:
        raise BenchmarkError("git_metadata_timeout") from error
    except OSError as error:
        raise BenchmarkError("git_metadata_unavailable") from error

    if revision.returncode != 0 or worktree.returncode != 0:
        raise BenchmarkError("git_metadata_unavailable")
    if len(revision.stdout) > 128 or len(worktree.stdout) > MAX_GIT_STATUS_BYTES:
        raise BenchmarkError("git_metadata_malformed")
    try:
        head_sha = revision.stdout.decode("ascii", errors="strict").strip()
    except UnicodeDecodeError as error:
        raise BenchmarkError("git_metadata_malformed") from error
    if not SAFE_GIT_SHA.fullmatch(head_sha):
        raise BenchmarkError("git_metadata_malformed")
    return head_sha, worktree.stdout == b""


def nearest_rank(samples: list[int], quantile: float) -> int:
    if not samples or not 0 < quantile <= 1:
        raise BenchmarkError("invalid_measurement")
    ordered = sorted(samples)
    rank = max(1, math.ceil(quantile * len(ordered)))
    return ordered[rank - 1]


def milliseconds(nanoseconds: int | float) -> float:
    value = round(nanoseconds / 1_000_000, 3)
    if not math.isfinite(value) or value <= 0:
        raise BenchmarkError("invalid_measurement")
    return value


def summarize(scenario: Scenario, samples: list[int]) -> dict[str, object]:
    if not samples or any(sample <= 0 for sample in samples):
        raise BenchmarkError("invalid_measurement")
    total_ns = sum(samples)
    throughput = round(len(samples) / (total_ns / 1_000_000_000), 3)
    if not math.isfinite(throughput) or throughput <= 0:
        raise BenchmarkError("invalid_measurement")
    return {
        "scenario_id": scenario.identifier,
        "measurement_target": scenario.measurement_target,
        "sample_count": len(samples),
        "iteration_wall_clock_ms": {
            "minimum": milliseconds(min(samples)),
            "mean": milliseconds(total_ns / len(samples)),
            "p50": milliseconds(nearest_rank(samples, 0.50)),
            "p95": milliseconds(nearest_rank(samples, 0.95)),
            "p99": milliseconds(nearest_rank(samples, 0.99)),
            "maximum": milliseconds(max(samples)),
            "total": milliseconds(total_ns),
        },
        "throughput_iterations_per_second": throughput,
    }


def validate_summary(summary: object, expected_samples: int) -> None:
    if not isinstance(summary, dict) or set(summary) != {
        "scenario_id",
        "measurement_target",
        "sample_count",
        "iteration_wall_clock_ms",
        "throughput_iterations_per_second",
    }:
        raise BenchmarkError("result_schema_invalid")
    if summary["scenario_id"] not in {scenario.identifier for scenario in SCENARIOS}:
        raise BenchmarkError("result_schema_invalid")
    if summary["measurement_target"] != "release_test_process_wall_clock":
        raise BenchmarkError("result_schema_invalid")
    if summary["sample_count"] != expected_samples:
        raise BenchmarkError("result_schema_invalid")
    metrics = summary["iteration_wall_clock_ms"]
    if not isinstance(metrics, dict) or set(metrics) != {
        "minimum",
        "mean",
        "p50",
        "p95",
        "p99",
        "maximum",
        "total",
    }:
        raise BenchmarkError("result_schema_invalid")
    values = [metrics[key] for key in ("minimum", "p50", "p95", "p99", "maximum")]
    if any(
        isinstance(value, bool)
        or not isinstance(value, (int, float))
        or not math.isfinite(value)
        or value <= 0
        for value in (*values, metrics["mean"], metrics["total"])
    ):
        raise BenchmarkError("result_schema_invalid")
    if values != sorted(values) or metrics["total"] < metrics["maximum"]:
        raise BenchmarkError("result_schema_invalid")
    throughput = summary["throughput_iterations_per_second"]
    if (
        isinstance(throughput, bool)
        or not isinstance(throughput, (int, float))
        or not math.isfinite(throughput)
        or throughput <= 0
    ):
        raise BenchmarkError("result_schema_invalid")
    expected_total = metrics["mean"] * expected_samples
    if abs(metrics["total"] - expected_total) > max(0.002 * expected_samples, 0.002):
        raise BenchmarkError("result_schema_invalid")
    expected_throughput = 1000 * expected_samples / metrics["total"]
    if abs(throughput - expected_throughput) > max(0.002, expected_throughput * 0.0001):
        raise BenchmarkError("result_schema_invalid")


def build_report(
    summaries: list[dict[str, object]],
    iterations: int,
    warmup: int,
    cargo_version: str,
    rustc_version: str,
    head_sha: str,
    worktree_clean: bool,
) -> dict[str, object]:
    for summary in summaries:
        validate_summary(summary, iterations)
    measured_scenarios = {summary["scenario_id"] for summary in summaries}
    required_scenarios = {scenario.identifier for scenario in SCENARIOS}
    release_eligible = (
        worktree_clean
        and measured_scenarios == required_scenarios
        and iterations == DEFAULT_ITERATIONS
        and warmup == DEFAULT_WARMUP
    )
    report: dict[str, object] = {
        "$schema": SCHEMA_REFERENCE,
        "schema_version": 1,
        "status": "pass",
        "git_head_sha": head_sha,
        "worktree_clean": worktree_clean,
        "release_eligible": release_eligible,
        "generated_at_utc": dt.datetime.now(dt.timezone.utc)
        .replace(microsecond=0)
        .isoformat()
        .replace("+00:00", "Z"),
        "network_scope": "cargo_offline_loopback_only",
        "build_profile": "release",
        "metric_scope": "whole_test_process_not_request_latency",
        "iterations_per_scenario": iterations,
        "warmup_iterations_per_scenario": warmup,
        "toolchain": {
            "cargo_semver": cargo_version,
            "rustc_semver": rustc_version,
        },
        "scenarios": summaries,
    }
    validate_report(report)
    return report


def validate_report(report: object) -> None:
    if not isinstance(report, dict) or set(report) != {
        "$schema",
        "schema_version",
        "status",
        "git_head_sha",
        "worktree_clean",
        "release_eligible",
        "generated_at_utc",
        "network_scope",
        "build_profile",
        "metric_scope",
        "iterations_per_scenario",
        "warmup_iterations_per_scenario",
        "toolchain",
        "scenarios",
    }:
        raise BenchmarkError("result_schema_invalid")
    if (
        report["$schema"] != SCHEMA_REFERENCE
        or report["schema_version"] != 1
        or report["status"] != "pass"
        or report["network_scope"] != "cargo_offline_loopback_only"
        or report["build_profile"] != "release"
        or report["metric_scope"] != "whole_test_process_not_request_latency"
    ):
        raise BenchmarkError("result_schema_invalid")
    if not isinstance(report["git_head_sha"], str) or not SAFE_GIT_SHA.fullmatch(
        report["git_head_sha"]
    ):
        raise BenchmarkError("result_schema_invalid")
    if not isinstance(report["worktree_clean"], bool) or not isinstance(
        report["release_eligible"], bool
    ):
        raise BenchmarkError("result_schema_invalid")
    if report["release_eligible"] and not (
        report["status"] == "pass"
        and report["worktree_clean"]
        and report["iterations_per_scenario"] == DEFAULT_ITERATIONS
        and report["warmup_iterations_per_scenario"] == DEFAULT_WARMUP
    ):
        raise BenchmarkError("result_schema_invalid")
    if not isinstance(report["generated_at_utc"], str) or not re.fullmatch(
        r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z",
        report["generated_at_utc"],
    ):
        raise BenchmarkError("result_schema_invalid")
    iterations = report["iterations_per_scenario"]
    warmup = report["warmup_iterations_per_scenario"]
    if (
        isinstance(iterations, bool)
        or not isinstance(iterations, int)
        or not 1 <= iterations <= MAX_ITERATIONS
        or isinstance(warmup, bool)
        or not isinstance(warmup, int)
        or not 0 <= warmup <= MAX_WARMUP
    ):
        raise BenchmarkError("result_schema_invalid")
    toolchain = report["toolchain"]
    if not isinstance(toolchain, dict) or set(toolchain) != {
        "cargo_semver",
        "rustc_semver",
    }:
        raise BenchmarkError("result_schema_invalid")
    if any(
        not isinstance(value, str) or not SAFE_SEMVER.fullmatch(value)
        for value in toolchain.values()
    ):
        raise BenchmarkError("result_schema_invalid")
    scenarios = report["scenarios"]
    if not isinstance(scenarios, list) or not 1 <= len(scenarios) <= len(SCENARIOS):
        raise BenchmarkError("result_schema_invalid")
    identifiers: set[str] = set()
    for summary in scenarios:
        validate_summary(summary, iterations)
        identifier = summary["scenario_id"]
        if identifier in identifiers:
            raise BenchmarkError("result_schema_invalid")
        identifiers.add(identifier)
    if report["release_eligible"] and identifiers != {
        scenario.identifier for scenario in SCENARIOS
    }:
        raise BenchmarkError("result_schema_invalid")


def report_path(raw: str) -> Path:
    if not re.fullmatch(r"reports/generated/benchmark(?:-[a-z0-9_-]{1,48})?\.json", raw):
        raise BenchmarkError("report_path_rejected")
    return REPO_ROOT / raw


def create_private_directory(path: Path) -> None:
    previous_umask = os.umask(0o077)
    try:
        os.mkdir(path, mode=0o700)
    except FileExistsError:
        pass
    except OSError as error:
        raise BenchmarkError("report_directory_unavailable") from error
    finally:
        os.umask(previous_umask)


def validate_directory(path: Path, require_private: bool) -> os.stat_result:
    try:
        metadata = os.lstat(path)
    except FileNotFoundError as error:
        raise BenchmarkError("report_directory_unavailable") from error
    except OSError as error:
        raise BenchmarkError("report_directory_unavailable") from error
    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISDIR(metadata.st_mode):
        raise BenchmarkError("report_directory_rejected")
    if require_private and stat.S_IMODE(metadata.st_mode) != 0o700:
        raise BenchmarkError("report_directory_permissions")
    return metadata


def directory_open_flags() -> int:
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0)
    flags |= getattr(os, "O_DIRECTORY", 0)
    flags |= getattr(os, "O_NOFOLLOW", 0)
    return flags


def create_private_subdirectory(parent_fd: int, name: str) -> None:
    previous_umask = os.umask(0o077)
    try:
        os.mkdir(name, mode=0o700, dir_fd=parent_fd)
    except FileExistsError:
        pass
    except OSError as error:
        raise BenchmarkError("report_directory_unavailable") from error
    finally:
        os.umask(previous_umask)


def open_report_directory() -> int:
    reports_directory = REPO_ROOT / "reports"
    if not reports_directory.exists():
        create_private_directory(reports_directory)
    expected_reports = validate_directory(reports_directory, require_private=False)
    try:
        reports_fd = os.open(reports_directory, directory_open_flags())
    except OSError as error:
        raise BenchmarkError("report_directory_unavailable") from error
    try:
        if not os.path.samestat(expected_reports, os.fstat(reports_fd)):
            raise BenchmarkError("report_directory_changed")
        try:
            expected_generated = os.stat(
                "generated", dir_fd=reports_fd, follow_symlinks=False
            )
        except FileNotFoundError:
            create_private_subdirectory(reports_fd, "generated")
            try:
                expected_generated = os.stat(
                    "generated", dir_fd=reports_fd, follow_symlinks=False
                )
            except OSError as error:
                raise BenchmarkError("report_directory_unavailable") from error
        except OSError as error:
            raise BenchmarkError("report_directory_unavailable") from error
        if (
            stat.S_ISLNK(expected_generated.st_mode)
            or not stat.S_ISDIR(expected_generated.st_mode)
        ):
            raise BenchmarkError("report_directory_rejected")
        if stat.S_IMODE(expected_generated.st_mode) != 0o700:
            raise BenchmarkError("report_directory_permissions")
        try:
            generated_fd = os.open(
                "generated", directory_open_flags(), dir_fd=reports_fd
            )
        except OSError as error:
            raise BenchmarkError("report_directory_unavailable") from error
        if not os.path.samestat(expected_generated, os.fstat(generated_fd)):
            os.close(generated_fd)
            raise BenchmarkError("report_directory_changed")
        return generated_fd
    finally:
        os.close(reports_fd)


def validate_existing_destination(directory_fd: int, name: str) -> None:
    try:
        metadata = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
    except FileNotFoundError:
        return
    except OSError as error:
        raise BenchmarkError("report_destination_rejected") from error
    if (
        not stat.S_ISREG(metadata.st_mode)
        or metadata.st_nlink != 1
        or stat.S_IMODE(metadata.st_mode) != 0o600
    ):
        raise BenchmarkError("report_destination_rejected")


def open_private_temporary(directory_fd: int) -> tuple[int, str]:
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    flags |= getattr(os, "O_CLOEXEC", 0)
    flags |= getattr(os, "O_NOFOLLOW", 0)
    for _ in range(16):
        name = f".benchmark-{os.urandom(16).hex()}.tmp"
        try:
            descriptor = os.open(name, flags, 0o600, dir_fd=directory_fd)
        except FileExistsError:
            continue
        except OSError as error:
            raise BenchmarkError("report_write_failed") from error
        try:
            os.fchmod(descriptor, 0o600)
            metadata = os.fstat(descriptor)
        except OSError as error:
            os.close(descriptor)
            raise BenchmarkError("report_write_failed") from error
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or stat.S_IMODE(metadata.st_mode) != 0o600
        ):
            os.close(descriptor)
            raise BenchmarkError("report_write_failed")
        return descriptor, name
    raise BenchmarkError("report_write_failed")


def write_all(descriptor: int, payload: bytes) -> None:
    remaining = memoryview(payload)
    while remaining:
        written = os.write(descriptor, remaining)
        if written <= 0:
            raise BenchmarkError("report_write_failed")
        remaining = remaining[written:]
    os.fsync(descriptor)


def verify_final_report(
    directory_fd: int, name: str, expected_payload: bytes
) -> None:
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0)
    flags |= getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(name, flags, dir_fd=directory_fd)
    except OSError as error:
        raise BenchmarkError("report_verification_failed") from error
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or stat.S_IMODE(metadata.st_mode) != 0o600
            or metadata.st_size != len(expected_payload)
        ):
            raise BenchmarkError("report_verification_failed")
        observed = bytearray()
        while len(observed) <= len(expected_payload):
            read_size = min(65536, len(expected_payload) + 1 - len(observed))
            chunk = os.read(descriptor, read_size)
            if not chunk:
                break
            observed.extend(chunk)
        if bytes(observed) != expected_payload:
            raise BenchmarkError("report_verification_failed")
    finally:
        os.close(descriptor)


def write_report(path: Path, report: dict[str, object]) -> None:
    payload = (json.dumps(report, indent=2, sort_keys=True) + "\n").encode("utf-8")
    try:
        reparsed = json.loads(payload)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise BenchmarkError("result_serialization_failed") from error
    validate_report(reparsed)
    if path.parent != REPORT_ROOT:
        raise BenchmarkError("report_path_rejected")

    directory_fd = open_report_directory()
    descriptor = -1
    temporary_name: str | None = None
    try:
        validate_existing_destination(directory_fd, path.name)
        descriptor, temporary_name = open_private_temporary(directory_fd)
        write_all(descriptor, payload)
        os.close(descriptor)
        descriptor = -1
        os.replace(
            temporary_name,
            path.name,
            src_dir_fd=directory_fd,
            dst_dir_fd=directory_fd,
        )
        temporary_name = None
        os.fsync(directory_fd)
        verify_final_report(directory_fd, path.name, payload)
    except BenchmarkError:
        raise
    except OSError as error:
        raise BenchmarkError("report_write_failed") from error
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        if temporary_name is not None:
            try:
                os.unlink(temporary_name, dir_fd=directory_fd)
            except FileNotFoundError:
                pass
            except OSError:
                pass
        os.close(directory_fd)


def main() -> int:
    arguments = parse_args()
    environment = benchmark_environment()
    scenarios = selected_scenarios(arguments.scenario)
    output_path = None if arguments.no_report else report_path(arguments.report)

    print(
        "benchmark: status=running "
        f"scenarios={len(scenarios)} iterations={arguments.iterations} "
        f"warmup={arguments.warmup} network=offline_loopback"
    )

    initial_head_sha, initially_clean = git_metadata(
        environment, arguments.timeout_seconds
    )
    cargo_version = tool_semver("cargo", environment, arguments.timeout_seconds)
    rustc_version = tool_semver("rustc", environment, arguments.timeout_seconds)

    summaries: list[dict[str, object]] = []
    for scenario in scenarios:
        verify_exact_test(scenario, environment, arguments.timeout_seconds)
        print(f"benchmark: scenario={scenario.identifier} status=running")
        for _ in range(arguments.warmup):
            run_hidden(scenario.command, environment, arguments.timeout_seconds)
        samples = [
            run_hidden(scenario.command, environment, arguments.timeout_seconds)
            for _ in range(arguments.iterations)
        ]
        summary = summarize(scenario, samples)
        validate_summary(summary, arguments.iterations)
        summaries.append(summary)
        metrics = summary["iteration_wall_clock_ms"]
        print(
            f"benchmark: scenario={scenario.identifier} status=pass "
            f"samples={summary['sample_count']} p50_ms={metrics['p50']:.3f} "
            f"p95_ms={metrics['p95']:.3f} "
            "throughput_unit=iterations_per_second "
            f"throughput={summary['throughput_iterations_per_second']:.3f}"
        )

    final_head_sha, finally_clean = git_metadata(environment, arguments.timeout_seconds)
    if final_head_sha != initial_head_sha:
        raise BenchmarkError("repository_changed")
    worktree_clean = initially_clean and finally_clean
    report = build_report(
        summaries,
        arguments.iterations,
        arguments.warmup,
        cargo_version,
        rustc_version,
        final_head_sha,
        worktree_clean,
    )
    if output_path is not None:
        write_report(output_path, report)
        print("benchmark: report=written permissions=0600 content=value_free")
    else:
        print("benchmark: report=skipped reason=explicit_no_report")
    print(
        "benchmark: status=pass metric_scope=whole_test_process_not_request_latency "
        f"worktree_clean={str(worktree_clean).lower()} "
        f"release_eligible={str(report['release_eligible']).lower()}"
    )
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except BenchmarkError as error:
        print(
            f"benchmark: status=fail reason={error.reason} output=suppressed",
            file=sys.stderr,
        )
        raise SystemExit(1) from None
    except KeyboardInterrupt:
        print("benchmark: status=fail reason=interrupted output=suppressed", file=sys.stderr)
        raise SystemExit(130) from None
    except Exception:
        print("benchmark: status=fail reason=internal_error output=suppressed", file=sys.stderr)
        raise SystemExit(1) from None
